# API Settings
API_V1_STR=/api/v1
PROJECT_NAME=VibeProject

# CORS Settings
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Authentication (JWT)
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
DATABASE_URL=sqlite:///./vibeproject.db

# Qdrant (local on-disk)
QDRANT_LOCAL_PATH=./qdrant_storage

# Upload storage
UPLOAD_DIR=./uploads
IMAGE_DIR=./uploads/images

# OpenRouter API
OPENROUTER_API_KEY=

#RAG
RAG_VISION_MODEL=qwen/qwen3.6-flash
RAG_ANSWER_MODEL=openai/gpt-5.2
RAG_PLANNER_MODEL=qwen/qwen3.6-flash
RAG_EMBEDDING_MODEL=qwen/qwen3-embedding-8b # 4096-dim

# Paper2Code pipeline
PAPER2CODE_CODE_MODEL=minimax/minimax-m2.7
PAPER2CODE_OUTPUT_DIR=../paper2code_outputs

# Paper2Poster pipeline
PAPER2POSTER_TEXT_MODEL=qwen/qwen3.6-flash
PAPER2POSTER_VISION_MODEL=qwen/qwen3-vl-32b-instruct
PAPER2POSTER_DIR=./app/agents
PAPER2POSTER_OUTPUT_DIR=../paper2poster_outputs

# Paper2Web pipeline
PAPER2WEB_TEXT_MODEL=qwen/qwen3.6-flash
PAPER2WEB_GENERATOR_MODEL=qwen/qwen3-coder-next
PAPER2WEB_VISION_MODEL=qwen/qwen3-vl-32b-instruct
PAPER2WEB_CODE_MODEL=qwen/qwen3-coder-next
PAPER2WEB_DIR=./app/agents
PAPER2WEB_OUTPUT_DIR=../paper2web_outputs