# API Settings
API_V1_STR=/api/v1
PROJECT_NAME=VibeProject

# Database (SQLite default; swap to postgresql+asyncpg://... for production)
DATABASE_URL=sqlite:///./vibeproject.db

# Authentication
SECRET_KEY=changeme-replace-with-a-long-random-string-in-production

# CORS Settings
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# OpenRouter API
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=qwen/qwen3.5-plus-02-15
OPENROUTER_ANSWER_MODEL=openai/gpt-5.2
OPENROUTER_PLANNER_MODEL=qwen/qwen3.5-plus-02-15
OPENROUTER_CODE_MODEL=minimax/minimax-m2.5
OPENROUTER_EMBEDDING_MODEL=qwen/qwen3-embedding-8b

# Paper2Poster pipeline
POSTER_MODEL_T=openai/gpt-4o-mini
POSTER_MODEL_V=google/gemini-flash-1.5
PAPER2POSTER_DIR=./app/poster_pipeline
PAPER2POSTER_OUTPUT_DIR=../paper2poster_outputs

# Paper2Web pipeline
# These are internal aliases resolved by web_pipeline/utils/wei_utils.py,
# not raw OpenRouter model IDs.
# Available aliases: openrouter_qwen3_30b_a3b, openrouter_qwen3_coder,
#                    openrouter_qwen2_5_VL_72B, openrouter_qwen3_235b_a22b
WEB_MODEL_T=openrouter_qwen3_30b_a3b
WEB_MODEL_G=openrouter_qwen3_coder
WEB_MODEL_V=openrouter_qwen2_5_VL_72B
WEB_MODEL_C=openrouter_qwen3_coder
PAPER2WEB_DIR=./app/web_pipeline
PAPER2WEB_OUTPUT_DIR=../paper2web_outputs